      "title": "Uplink Details — RSSI, SNR, Frame Counter, Port",
      "type": "table",
      "targets": [
        {
          "datasource": { "type": "influxdb", "uid": "${DS_INFLUXDB}" },
          "query": "import \"join\"\n\nrssi = from(bucket: \"MSiOT_Test_db\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_uplink\")\n  |> filter(fn: (r) => r._field == \"rssi\")\n  |> keep(columns: [\"_time\", \"_value\", \"dev_eui\", \"device_name\", \"application_name\", \"f_port\"])\n  |> rename(columns: {_value: \"rssi\"})\n\nsnr = from(bucket: \"MSiOT_Test_db\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_uplink\")\n  |> filter(fn: (r) => r._field == \"snr\")\n  |> keep(columns: [\"_time\", \"_value\", \"dev_eui\"])\n  |> rename(columns: {_value: \"snr\"})\n\nfcnt = from(bucket: \"MSiOT_Test_db\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"device_uplink\")\n  |> filter(fn: (r) => r._field == \"f_cnt\")\n  |> keep(columns: [\"_time\", \"_value\", \"dev_eui\"])\n  |> rename(columns: {_value: \"f_cnt\"})\n\nj1 = join.inner(left: rssi, right: snr, on: (l, r) => l._time == r._time and l.dev_eui == r.dev_eui, as: (l, r) => ({l with snr: r.snr}))\njoin.inner(left: j1, right: fcnt, on: (l, r) => l._time == r._time and l.dev_eui == r.dev_eui, as: (l, r) => ({l with f_cnt: r.f_cnt}))\n  |> sort(columns: [\"_time\"], desc: true)\n  |> limit(n: 100)",
          "refId": "A"
        }
      ]
