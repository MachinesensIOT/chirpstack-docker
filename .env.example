# InfluxDB configuration
# Pre-shared API token used by ChirpStack integration and Grafana to authenticate with InfluxDB.
# Replace with a strong, randomly generated token before deploying to production.
INFLUXDB_ADMIN_TOKEN=your-influxdb-admin-token-here

# InfluxDB admin username
INFLUXDB_ADMIN_USERNAME=admin

# InfluxDB admin password
INFLUXDB_ADMIN_PASSWORD=your-influxdb-password-here

# InfluxDB organisation name
INFLUXDB_ORG=chirpstack

# InfluxDB bucket where ChirpStack device data will be stored
INFLUXDB_BUCKET=chirpstack

# Grafana admin username
GF_SECURITY_ADMIN_USER=admin

# Grafana admin password — change this before exposing Grafana publicly
GF_SECURITY_ADMIN_PASSWORD=your-grafana-password-here
